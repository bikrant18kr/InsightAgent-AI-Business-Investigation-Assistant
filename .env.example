# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# For remote or local PostgreSQL, provide standard connection string:
# DATABASE_URL=postgres://postgres:password@localhost:5432/insightagent
DATABASE_URL=

# OpenAI API Key (Keep strictly server-side)
# If left empty, InsightAgent runs in Mock Mode with zero external network dependencies
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional frontend allowed origin (CORS)
ALLOWED_ORIGIN=http://localhost:5173
